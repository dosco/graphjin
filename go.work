go 1.26.10

// One Go workspace for GraphJin's modules and the OpenNeko apps, so every
// shared dependency resolves to one version.
use (
	./agent
	./apps/ax-harness
	./apps/lazy-service
	./apps/openneko
	./auth
	./cassandradriver
	./clickhousedriver
	./cmd
	./codesql
	./conf
	./core
	./examples
	./examples/pcb-fab/mockapi
	./hostedemu
	./mongodriver
	./packages/graphjin-contract/generate
	./plugin/otel
	./serv
	./tests
	./wasm
)
