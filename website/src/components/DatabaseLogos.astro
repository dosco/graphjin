---
const databases = [
  { name: 'PostgreSQL', logo: '/logos/postgresql.svg' },
  { name: 'MySQL', logo: '/logos/mysql.svg' },
  { name: 'MariaDB', logo: '/logos/mariadb.svg' },
  { name: 'MongoDB', logo: '/logos/mongodb.svg' },
  { name: 'SQLite', logo: '/logos/sqlite.svg' },
  { name: 'SQL Server', logo: '/logos/mssql.svg' },
  { name: 'Oracle', logo: '/logos/oracle.svg' },
  { name: 'CockroachDB', logo: '/logos/cockroachdb.svg' },
  { name: 'YugabyteDB', logo: '/logos/yugabytedb.svg' },
  { name: 'Snowflake', logo: '/logos/snowflake.svg' },
  { name: 'BigQuery', label: 'BQ' },
  { name: 'AWS Aurora', logo: '/logos/aws-aurora.svg' },
  { name: 'Cloud SQL', logo: '/logos/google-cloud-sql.svg' },
  { name: 'HTTP APIs', label: 'API' },
  { name: 'S3 / GCS / Files', label: 'OBJ' },
  { name: 'Code', label: '{ }' },
];
---

<section
  class="py-20 md:py-24 border-t"
  style="border-color: var(--color-border)"
>
  <div class="container-doc">
    <header class="max-w-3xl mb-12">
      <span class="eyebrow">DATABASES</span>
      <h2
        class="mt-4 text-3xl md:text-5xl font-display font-bold tracking-tight"
        style="color: var(--color-text); line-height: 1.08"
      >
        Works with all your databases. And more.
      </h2>
      <p
        class="mt-4 text-lg md:text-xl leading-relaxed"
        style="color: var(--color-muted)"
      >
        Point GraphJin at <strong style="color: var(--color-text)">as many systems as you need</strong>
        — Postgres for users, MySQL for orders, Snowflake and BigQuery for analytics, MongoDB for events,
        HTTP APIs for remote services, object storage for files, and CodeSQL for source
        trees — and query them through a single GraphQL endpoint. Joins, remote joins,
        subscriptions, search, and mutations compose
        <strong style="color: var(--color-text)">across systems in one request</strong>, so an AI
        assistant can reason across the data, APIs, files, and code without learning every backend.
      </p>
    </header>

    <ul class="db-grid">
      {databases.map((db) => (
        <li class="db-item">
          <div class="db-icon">
            {db.logo ? (
              <img src={db.logo} alt={db.name} loading="lazy" />
            ) : (
              <span class="db-label-icon" aria-hidden="true">{db.label}</span>
            )}
          </div>
          <span class="db-name">{db.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .db-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 640px) {
    .db-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .db-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .db-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .db-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transition: transform 0.18s ease;
  }
  .db-item:hover {
    transform: translateY(-2px);
  }

  .db-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .db-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .db-label-icon {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
  }

  .db-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-align: center;
    white-space: nowrap;
  }
</style>
