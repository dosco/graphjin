---
interface Item {
  id: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<aside
  class="otp hidden 2xl:block fixed top-24 right-10 w-52 z-30"
  aria-label="On this page"
>
  <div
    class="rounded-xl border p-4 backdrop-blur"
    style="background: color-mix(in srgb, var(--color-bg) 75%, transparent); border-color: var(--color-border)"
  >
    <p
      class="text-[10px] font-mono uppercase tracking-[0.18em] mb-3"
      style="color: var(--color-muted)"
    >
      On this page
    </p>
    <ul class="space-y-1.5">
      {items.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            data-otp-link={item.id}
            class="otp-link block text-[13px] leading-snug py-1 px-2 -mx-2 rounded transition-colors"
            style="color: var(--color-muted)"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .otp-link[data-active="true"] {
    color: var(--color-accent) !important;
    background: var(--color-accent-soft);
  }
  .otp-link:hover {
    color: var(--color-text) !important;
  }
  .otp > div {
    max-height: calc(100vh - 7rem);
    overflow: auto;
  }
  :global(section[id]) {
    scroll-margin-top: 6rem;
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-otp-link]");
  if (links.length) {
    const ids = Array.from(links)
      .map((l) => l.getAttribute("data-otp-link"))
      .filter((v): v is string => Boolean(v));
    const targets = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    let activeId: string | null = null;
    const setActive = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((link) => {
        const linkId = link.getAttribute("data-otp-link");
        link.setAttribute("data-active", linkId === id ? "true" : "false");
      });
    };

    const currentSectionId = () => {
      if (!targets.length) return null;

      if (
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 4
      ) {
        return targets[targets.length - 1].id;
      }

      const anchorY = Math.min(window.innerHeight * 0.35, 220);
      let current: string | null = targets[0].id;

      for (const target of targets) {
        const rect = target.getBoundingClientRect();

        if (rect.top <= anchorY && rect.bottom > anchorY) {
          return target.id;
        }

        if (rect.top <= anchorY) {
          current = target.id;
        }
      }

      return current;
    };

    let scheduled = false;
    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        setActive(currentSectionId());
      });
    };

    links.forEach((link) => {
      link.addEventListener("click", () => {
        setActive(link.getAttribute("data-otp-link"));
      });
    });

    scheduleUpdate();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    window.addEventListener("load", scheduleUpdate);
  }
</script>
