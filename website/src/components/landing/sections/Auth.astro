---
import FeatureSection from "../FeatureSection.astro";
import AuthModes from "../diagrams/AuthModes.astro";
import CodeCard from "../CodeCard.astro";

const config = `# config/prod.yml
auth:
  type: jwt
  jwt:
    provider: "auth0"          # or firebase, okta, custom
    audience: "https://api.example.com"
    jwks_url: "https://example.auth0.com/.well-known/jwks.json"
  cookie: "gj_session"

auth_login:
  enabled: true                # OIDC device-code login for CLI / legacy MCP fallback
  provider: "https://login.example.com"
  client_id: "graphjin-cli"
  scopes: ["openid", "email", "offline_access"]

mcp:
  oauth:
    enabled: true
    mode: builtin              # reuse auth_login identity for hosted MCP OAuth
`;

const rbac = `# config/roles.yml
roles:
  - name: anon
    tables:
      products: { query: { columns: [id, name, price] } }

  - name: user
    tables:
      orders:
        query:  { filters: ["{ user_id: { eq: $user_id } }"] }
        insert: { columns: [product_id, quantity] }
        update: { filters: ["{ status: { eq: \"draft\" } }"] }
`;
---

<FeatureSection
  id="auth"
  eyebrow="SECURITY"
  title="OAuth, JWT, OIDC — and row-level rules."
  lede="JWT from Auth0, Firebase, Okta, or any JWKS endpoint. Header- or cookie-based sessions for legacy stacks. OIDC device-code login for the CLI, plus MCP OAuth for hosted AI clients. Whatever the source, every request lands in the same context, so one AI surface can be governed with RBAC, row-level filters, and audited policy."
>
  <Fragment slot="body">
    <p>
      Configure once. Every transport — HTTP, WebSocket, SSE, MCP — runs the
      same auth pipeline. <strong>Roles + row-level filters</strong> are
      authored in YAML and enforced inside the compiler, so even an agent-run
      workflow cannot read or write outside its lane.
    </p>
    <p>
      MCP OAuth uses the same verified identity, RBAC, row filters, source
      access, and tool gates as the rest of GraphJin. The CLI can still use
      OIDC device-code: open a URL, approve, done.
    </p>
  </Fragment>

  <AuthModes slot="diagram" />

  <Fragment slot="snippet">
    <CodeCard filename="config/prod.yml" language="yaml" code={config} />
    <CodeCard filename="config/roles.yml" language="yaml" code={rbac} />
  </Fragment>
</FeatureSection>
