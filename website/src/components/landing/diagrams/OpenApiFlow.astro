---
// OpenAPI specs + DB tables compose into a single GraphQL response.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 320"
    role="img"
    aria-label="GraphJin loads OpenAPI specs alongside databases and joins them through one GraphQL request"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="oa-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* Sources — left */}
    <g class="diag-node">
      <rect x="20" y="20" width="180" height="60" rx="12" />
      <text x="110" y="48" text-anchor="middle" class="diag-label">stripe.yaml</text>
      <text x="110" y="68" text-anchor="middle" class="diag-sub">OpenAPI 3 spec</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="105" width="180" height="60" rx="12" />
      <text x="110" y="133" text-anchor="middle" class="diag-label">stripe</text>
      <text x="110" y="153" text-anchor="middle" class="diag-sub">live REST endpoint</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="190" width="180" height="60" rx="12" />
      <text x="110" y="218" text-anchor="middle" class="diag-label">customers</text>
      <text x="110" y="238" text-anchor="middle" class="diag-sub">postgres table</text>
    </g>

    {/* GraphJin */}
    <g class="diag-node diag-accent">
      <rect x="280" y="80" width="220" height="160" rx="14" />
      <text x="390" y="115" text-anchor="middle" class="diag-label">GRAPHJIN</text>
      <text x="390" y="140" text-anchor="middle" class="diag-sub">load · classify · join</text>
      <text x="390" y="160" text-anchor="middle" class="diag-sub">column → param map</text>
      <text x="390" y="180" text-anchor="middle" class="diag-sub">bearer · oauth2 · keys</text>
      <text x="390" y="208" text-anchor="middle" class="diag-pill">remote_api · db · workflows</text>
    </g>

    {/* Output */}
    <g class="diag-node">
      <rect x="560" y="115" width="220" height="90" rx="12" />
      <text x="670" y="148" text-anchor="middle" class="diag-label">UNIFIED RESPONSE</text>
      <text x="670" y="168" text-anchor="middle" class="diag-sub">customers + invoices in</text>
      <text x="670" y="188" text-anchor="middle" class="diag-sub">one GraphQL request</text>
    </g>

    {/* Lines */}
    <path d="M200 50 C 240 50, 240 130, 280 130" class="diag-line-dotted" />
    <path d="M200 135 L280 160" class="diag-line" marker-end="url(#oa-arrow)" />
    <path d="M200 220 C 240 220, 240 200, 280 195" class="diag-line" marker-end="url(#oa-arrow)" />
    <path d="M500 160 L560 160" class="diag-line" marker-end="url(#oa-arrow)" />
  </svg>
</div>