---
// Apollo Federation v2 supergraph: 3 GraphJin subgraphs -> Router -> client.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 320"
    role="img"
    aria-label="Three GraphJin subgraphs compose into a single supergraph behind Apollo Router"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="fed-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* Subgraphs */}
    <g class="diag-node">
      <rect x="20" y="20" width="180" height="70" rx="12" />
      <text x="110" y="48" text-anchor="middle" class="diag-label">graphjin-users</text>
      <text x="110" y="70" text-anchor="middle" class="diag-sub">@key("id") · users / sessions</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="125" width="180" height="70" rx="12" />
      <text x="110" y="153" text-anchor="middle" class="diag-label">graphjin-products</text>
      <text x="110" y="175" text-anchor="middle" class="diag-sub">@key("sku") · catalog</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="230" width="180" height="70" rx="12" />
      <text x="110" y="258" text-anchor="middle" class="diag-label">graphjin-orders</text>
      <text x="110" y="280" text-anchor="middle" class="diag-sub">@key("id") · orders / lines</text>
    </g>

    {/* Router */}
    <g class="diag-node diag-accent">
      <rect x="320" y="100" width="180" height="120" rx="14" />
      <text x="410" y="135" text-anchor="middle" class="diag-label">SUPERGRAPH ROUTER</text>
      <text x="410" y="160" text-anchor="middle" class="diag-sub">Apollo · Cosmo · Hive</text>
      <text x="410" y="185" text-anchor="middle" class="diag-sub">composed schema</text>
      <text x="410" y="208" text-anchor="middle" class="diag-pill">_service · entities</text>
    </g>

    {/* Client */}
    <g class="diag-node">
      <rect x="600" y="125" width="170" height="70" rx="12" />
      <text x="685" y="153" text-anchor="middle" class="diag-label">CLIENT</text>
      <text x="685" y="175" text-anchor="middle" class="diag-sub">single GraphQL request</text>
    </g>

    {/* Lines from subgraphs to router */}
    <path d="M200 55 C 260 55, 270 130, 320 145" class="diag-line" marker-end="url(#fed-arrow)" />
    <path d="M200 160 L320 160" class="diag-line" marker-end="url(#fed-arrow)" />
    <path d="M200 265 C 260 265, 270 195, 320 175" class="diag-line" marker-end="url(#fed-arrow)" />

    {/* Router to client */}
    <path d="M500 160 L600 160" class="diag-line" marker-end="url(#fed-arrow)" />
  </svg>
</div>