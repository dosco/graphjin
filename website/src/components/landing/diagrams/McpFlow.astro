---
// MCP request flow: AI client -> MCP transport -> guard -> compiler -> DB.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 280"
    role="img"
    aria-label="AI clients connect to GraphJin's MCP server, which routes tool calls through guards and the compiler"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="mcp-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* AI clients */}
    <g class="diag-node">
      <rect x="20" y="40" width="160" height="50" rx="10" />
      <text x="100" y="65" text-anchor="middle" class="diag-label">Claude Desktop</text>
      <text x="100" y="83" text-anchor="middle" class="diag-sub">stdio</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="115" width="160" height="50" rx="10" />
      <text x="100" y="140" text-anchor="middle" class="diag-label">Codex / Cursor</text>
      <text x="100" y="158" text-anchor="middle" class="diag-sub">http+sse</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="190" width="160" height="50" rx="10" />
      <text x="100" y="215" text-anchor="middle" class="diag-label">Custom MCP host</text>
      <text x="100" y="233" text-anchor="middle" class="diag-sub">spec</text>
    </g>

    {/* MCP server */}
    <g class="diag-node diag-accent">
      <rect x="230" y="60" width="200" height="160" rx="14" />
      <text x="330" y="95" text-anchor="middle" class="diag-label">GRAPHJIN MCP</text>
      <text x="330" y="118" text-anchor="middle" class="diag-sub">execute_graphql</text>
      <text x="330" y="135" text-anchor="middle" class="diag-sub">discover_schema</text>
      <text x="330" y="152" text-anchor="middle" class="diag-sub">saved_query · audit</text>
      <text x="330" y="190" text-anchor="middle" class="diag-pill">RBAC · allowlist · jwt</text>
    </g>

    {/* Compiler */}
    <g class="diag-node">
      <rect x="480" y="100" width="140" height="80" rx="12" />
      <text x="550" y="135" text-anchor="middle" class="diag-label">COMPILER</text>
      <text x="550" y="158" text-anchor="middle" class="diag-sub">GraphQL → SQL</text>
    </g>

    {/* DB */}
    <g class="diag-node">
      <rect x="660" y="115" width="120" height="50" rx="10" />
      <text x="720" y="143" text-anchor="middle" class="diag-label">DATABASE</text>
    </g>

    {/* Lines */}
    <path d="M180 65 C 210 65, 210 110, 230 110" class="diag-line" marker-end="url(#mcp-arrow)" />
    <path d="M180 140 L230 140" class="diag-line" marker-end="url(#mcp-arrow)" />
    <path d="M180 215 C 210 215, 210 170, 230 170" class="diag-line" marker-end="url(#mcp-arrow)" />
    <path d="M430 140 L480 140" class="diag-line" marker-end="url(#mcp-arrow)" />
    <path d="M620 140 L660 140" class="diag-line" marker-end="url(#mcp-arrow)" />
  </svg>
</div>