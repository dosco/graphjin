---
// Multipart upload pipeline: client -> multipart parser -> backend (S3/GCS/Local) -> fstable row.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 300"
    role="img"
    aria-label="Multipart uploads stream through GraphJin into S3, GCS, or local storage and surface as queryable rows"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="fs-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* Client */}
    <g class="diag-node">
      <rect x="20" y="115" width="140" height="70" rx="12" />
      <text x="90" y="143" text-anchor="middle" class="diag-label">CLIENT</text>
      <text x="90" y="165" text-anchor="middle" class="diag-sub">multipart/form-data</text>
    </g>

    {/* Multipart parser */}
    <g class="diag-node diag-accent">
      <rect x="200" y="115" width="180" height="70" rx="12" />
      <text x="290" y="143" text-anchor="middle" class="diag-label">GRAPHJIN UPLOAD</text>
      <text x="290" y="165" text-anchor="middle" class="diag-sub">stream · validate · sign</text>
    </g>

    {/* Backends */}
    <g class="diag-node">
      <rect x="430" y="20" width="160" height="60" rx="10" />
      <text x="510" y="48" text-anchor="middle" class="diag-label">S3</text>
      <text x="510" y="68" text-anchor="middle" class="diag-sub">aws · cloudflare r2</text>
    </g>
    <g class="diag-node">
      <rect x="430" y="115" width="160" height="60" rx="10" />
      <text x="510" y="143" text-anchor="middle" class="diag-label">GCS</text>
      <text x="510" y="163" text-anchor="middle" class="diag-sub">google cloud storage</text>
    </g>
    <g class="diag-node">
      <rect x="430" y="210" width="160" height="60" rx="10" />
      <text x="510" y="238" text-anchor="middle" class="diag-label">LOCAL</text>
      <text x="510" y="258" text-anchor="middle" class="diag-sub">disk volume</text>
    </g>

    {/* fstable row */}
    <g class="diag-node">
      <rect x="630" y="115" width="150" height="70" rx="12" />
      <text x="705" y="143" text-anchor="middle" class="diag-label">fstable row</text>
      <text x="705" y="165" text-anchor="middle" class="diag-sub">queryable · presign</text>
    </g>

    {/* Lines */}
    <path d="M160 150 L200 150" class="diag-line" marker-end="url(#fs-arrow)" />
    <path d="M380 150 C 410 150, 410 50, 430 50" class="diag-line" marker-end="url(#fs-arrow)" />
    <path d="M380 150 L430 145" class="diag-line" marker-end="url(#fs-arrow)" />
    <path d="M380 150 C 410 150, 410 240, 430 240" class="diag-line" marker-end="url(#fs-arrow)" />
    <path d="M590 50 C 615 50, 615 140, 630 140" class="diag-line-dotted" />
    <path d="M590 145 L630 150" class="diag-line-dotted" />
    <path d="M590 240 C 615 240, 615 160, 630 160" class="diag-line-dotted" />
  </svg>
</div>