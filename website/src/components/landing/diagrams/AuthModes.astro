---
// Auth fan-in: JWT / Header / OIDC device-code -> request context.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 300"
    role="img"
    aria-label="JWT, header tokens, and OIDC device-code login all resolve to a single authenticated request context"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="au-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* sources */}
    <g class="diag-node">
      <rect x="20" y="20" width="180" height="60" rx="12" />
      <text x="110" y="48" text-anchor="middle" class="diag-label">JWT</text>
      <text x="110" y="68" text-anchor="middle" class="diag-sub">Auth0 · Firebase · Okta · JWKS</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="105" width="180" height="60" rx="12" />
      <text x="110" y="133" text-anchor="middle" class="diag-label">HEADER · API KEY</text>
      <text x="110" y="153" text-anchor="middle" class="diag-sub">X-User-Id · X-Api-Key</text>
    </g>
    <g class="diag-node">
      <rect x="20" y="190" width="180" height="60" rx="12" />
      <text x="110" y="218" text-anchor="middle" class="diag-label">OIDC DEVICE-CODE</text>
      <text x="110" y="238" text-anchor="middle" class="diag-sub">graphjin cli setup</text>
    </g>

    {/* middleware */}
    <g class="diag-node diag-accent">
      <rect x="280" y="100" width="220" height="100" rx="14" />
      <text x="390" y="138" text-anchor="middle" class="diag-label">AUTH MIDDLEWARE</text>
      <text x="390" y="160" text-anchor="middle" class="diag-sub">verify · introspect · cache</text>
      <text x="390" y="183" text-anchor="middle" class="diag-pill">user · role · claims</text>
    </g>

    {/* request context */}
    <g class="diag-node">
      <rect x="560" y="115" width="220" height="70" rx="12" />
      <text x="670" y="143" text-anchor="middle" class="diag-label">REQUEST CONTEXT</text>
      <text x="670" y="165" text-anchor="middle" class="diag-sub">RBAC · row-level rules</text>
    </g>

    {/* lines */}
    <path d="M200 50 C 240 50, 240 130, 280 130" class="diag-line" marker-end="url(#au-arrow)" />
    <path d="M200 135 L280 150" class="diag-line" marker-end="url(#au-arrow)" />
    <path d="M200 220 C 240 220, 240 170, 280 170" class="diag-line" marker-end="url(#au-arrow)" />
    <path d="M500 150 L560 150" class="diag-line" marker-end="url(#au-arrow)" />
  </svg>
</div>