# GraphJin

### Go ###
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Profiling output
*.asm
*.pdf

### Go Patch ###
/vendor
/Godeps
/tmp
/tmp/runner-build
/demo/tmp
/demo/
.graphjin/
.gemini/
# Default extraction path for the built-in demo (cmd/cmd_demo_default.go);
# running `graphjin demo` or `graphjin serv` from a clone creates it.
/graphjin-demo/
examples/*/demo/
examples/*/codesql/

.idea
*.iml
.vscode
.DS_Store
.swp
/.release
/main
*-fuzz.zip
/crashers
/suppressions
/release
.gofuzz
*-fuzz.zip
*.test
.firebase
/dist
.idea
node_modules
# Ignore Go binary but not npm bin directory
/graphjin
!/npm/bin/
/npm/package-lock.json
slim.report.json
examples/nodejs/config/**/*.gql

*.mp4
*.mov
*.mp3
*.ac3
*.webm
*.log
*.txt
!apps/embedding/requirements*.txt
!**/LICENSE.txt

test.db
tests/.snowflake-capture/

cmd/cmd

.claude-plugins
# Local Claude state stays out, but skills that belong to this repo are part of
# it: they are how a coding agent working on GraphJin learns the workflows and
# the gates. .claude/worktrees and settings.local.json remain ignored.
.claude/*
!.claude/skills/
# Local WIP status files (never commit)
snowflake-wip.md
docs/DESIGN-OPENAPI-TOPLEVEL.md

.env

# agent data-eval ledger (reports are local artifacts)
.graphjin-evals/

# Python bytecode from the training client
__pycache__/
*.pyc
*.egg-info/

# OpenNeko

.next/
packages/llm/.cache/
apps/web/.cache/
apps/worker/.cache/
apps/web/test-results/
apps/web/playwright-report/

# Private plans and notes stay local. GraphJin tracks docs/.
/private/
.turbo/
dist/
build/
out/

.env.local
.env.*.local

# GraphJin's working dir for the dev stack: everything except templates and
# the committed operating-loop config is runtime.
db/graphjin/*
!db/graphjin/dev.example.yml
!db/graphjin/dev.sources.example.yml
!db/graphjin/customer.sources.example.yml

# local onboarding scratch
adventureworks-onboarding.md

# local agent-tool config (never part of the application runtime). GraphJin
# tracks .claude/skills/ and .codex/config.toml.
.agents/
.codex/*
!.codex/config.toml

# design preview screenshots
design-preview/

# CLI runtime dir: embedded compose and scratch artifacts written when
# `openneko start` runs from the source checkout
.openneko/

# Local dev bring-up artifacts
.local/
dev-volumes/
compose.dev-overrides.yml
