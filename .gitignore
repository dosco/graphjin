node_modules/
.next/

# transformers.js model cache — populated lazily on first embedText() call
# or via `pnpm --filter @neko/llm models:warm`. Files are large (>20MB
# quantized, >80MB FP32) and reproducible, so we don't track them.
packages/llm/.cache/
apps/web/.cache/
apps/worker/.cache/
apps/web/test-results/
apps/web/playwright-report/

/docs/
# Private plans and notes. The combined-root branch uses /private/ because
# GraphJin tracks docs/ there.
/private/
.turbo/
dist/
build/
out/
*.log
.DS_Store

.env
.env.local
.env.*.local

# GraphJin's working dir — everything except templates + committed
# operating-loop config is runtime
db/graphjin/*
!db/graphjin/dev.example.yml
!db/graphjin/dev.sources.example.yml
!db/graphjin/customer.sources.example.yml

# local onboarding scratch
adventureworks-onboarding.md

# editor
.vscode/
.idea/
*.swp

# local agent-tool config (never part of the application runtime)
.agents/
.claude/
.codex/

# design preview screenshots
design-preview/

# CLI runtime dir — embedded compose + scratch artifacts written when
# `openneko start` runs from the source checkout
.openneko/

# Per-host plugin manifest — written by `openneko plugin install`. Tracks
# the operator's installed plugins; not part of the source tree.
openneko.plugins.json
apps/*/openneko.plugins.json

# Local dev bring-up artifacts (source checkout with a host worker):
# plugin install dir, records-config bind mounts, and dev-only compose overrides
.local/
dev-volumes/
compose.dev-overrides.yml

# graphjin/ keeps its own .gitignore files. Re-include what it tracks that
# the rules above would hide.
!graphjin/.claude/
!graphjin/.codex/
