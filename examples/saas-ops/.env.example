# Copy to .env at the repo root (or next to this config). `graphjin serve
# --demo` loads it and auto-enables the agentic surface when a model provider
# key is present.

# One of these enables the server-side agent:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_APIKEY=

# Smoke-suite identity (defaults shown; the suite mints HS256 JWTs from the
# demo secret in agentic mode):
# GRAPHJIN_SMOKE_USER_ID=demo-user
# GRAPHJIN_SMOKE_USER_ROLE=user
# SMOKE_JWT_SECRET=saas-ops-demo-jwt-secret
