# Optional: copied or sourced by `graphjin serve --demo`.
# Agentic mode auto-enables when a provider key is present.
OPENAI_API_KEY=

# Smoke defaults.
GRAPHJIN_URL=http://localhost:8081
GRAPHJIN_AGENT_SMOKE=auto
GRAPHJIN_AGENT_EVAL=never
GRAPHJIN_SMOKE_TIMEOUT=240
GRAPHJIN_SMOKE_USER_ID=demo-user
GRAPHJIN_SMOKE_USER_ROLE=warehouse_manager
GRAPHJIN_SMOKE_ACCOUNT_ID=1
