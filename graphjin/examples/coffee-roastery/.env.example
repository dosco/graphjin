# Copy this file to .env to run the coffee roastery demo with the agent.
# Existing shell environment variables win over values in this file. Demo mode
# enables the agent automatically when it finds one of the provider keys below.

GO_ENV=agentic

# Pick one.
OPENAI_API_KEY=
# GOOGLE_APIKEY=
# ANTHROPIC_API_KEY=

# Optional provider override.
# GJ_AGENT_MODEL=
