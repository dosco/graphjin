---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import DatabaseLogos from '../components/DatabaseLogos.astro';

import HowItWorks from '../components/landing/sections/HowItWorks.astro';
import Agentic from '../components/landing/sections/Agentic.astro';
import WhyGraphjin from '../components/landing/sections/WhyGraphjin.astro';
import Federation from '../components/landing/sections/Federation.astro';
import Mcp from '../components/landing/sections/Mcp.astro';
import SecurityModel from '../components/landing/sections/SecurityModel.astro';
import CodeSQL from '../components/landing/sections/CodeSQL.astro';
import Filesystem from '../components/landing/sections/Filesystem.astro';
import OpenApi from '../components/landing/sections/OpenApi.astro';
import Cli from '../components/landing/sections/Cli.astro';
import Auth from '../components/landing/sections/Auth.astro';
import Subscriptions from '../components/landing/sections/Subscriptions.astro';

import OnThisPage from '../components/landing/OnThisPage.astro';

import FeatureGrid from '../components/react/FeatureGrid';
import QuickStart from '../components/react/QuickStart';
import GetStarted from '../components/react/GetStarted';
import ClaudeShowcase from '../components/react/ClaudeShowcase';
import Footer from '../components/Footer.astro';

const tocItems = [
  { id: 'how', label: 'How it works' },
  { id: 'agentic', label: 'Agentic' },
  { id: 'why', label: 'Why GraphJin' },
  { id: 'mcp', label: 'MCP' },
  { id: 'security-model', label: 'Security model' },
  { id: 'ai-queries', label: 'AI queries' },
  { id: 'codesql', label: 'CodeSQL' },
  { id: 'fstable', label: 'Filesystem' },
  { id: 'openapi', label: 'Remote APIs' },
  { id: 'cli', label: 'CLI' },
  { id: 'auth', label: 'Auth · OAuth' },
  { id: 'subscriptions', label: 'Subscriptions' },
  { id: 'features', label: 'Features' },
  { id: 'quickstart', label: 'Quickstart' },
  { id: 'federation', label: 'Federation' },
];
---

<Layout
  title="GraphJin — The compiler that connects AI to your organization"
  description="GraphJin auto-learns your schema and gives AI agents one governed query graph across databases, APIs, source code, filesystems, workflows, and security posture."
>
  <Navbar />

  <OnThisPage items={tocItems} />

  <main>
    <Hero />
    <DatabaseLogos />

    <HowItWorks />
    <Agentic />
    <WhyGraphjin />

    <Mcp />
    <SecurityModel />
    <ClaudeShowcase client:visible />
    <CodeSQL />
    <Filesystem />
    <OpenApi />
    <Cli />
    <Auth />
    <Subscriptions />

    <FeatureGrid client:visible />
    <QuickStart client:visible />
    <GetStarted client:visible />

    <Federation />
  </main>

  <Footer />
</Layout>
