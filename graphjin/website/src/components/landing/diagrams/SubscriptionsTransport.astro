---
// Sequence-style diagram: client subscribes; SSE/WebSocket transports; cursor pagination.
---

<div class="diagram-wrap">
  <svg
    viewBox="0 0 800 300"
    role="img"
    aria-label="Subscriptions stream changes back to clients over SSE or WebSocket with cursor-based pagination"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="sub-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-accent)" />
      </marker>
    </defs>

    {/* swimlane labels */}
    <text x="100" y="30" text-anchor="middle" class="diag-label">CLIENT</text>
    <text x="400" y="30" text-anchor="middle" class="diag-label">GRAPHJIN</text>
    <text x="700" y="30" text-anchor="middle" class="diag-label">DATABASE</text>

    {/* swimlanes */}
    <line x1="100" y1="50" x2="100" y2="270" class="diag-lane" />
    <line x1="400" y1="50" x2="400" y2="270" class="diag-lane" />
    <line x1="700" y1="50" x2="700" y2="270" class="diag-lane" />

    {/* messages */}
    <text x="250" y="78" text-anchor="middle" class="diag-sub">{"subscribe { … }"}</text>
    <path d="M100 90 L400 90" class="diag-line" marker-end="url(#sub-arrow)" />

    <text x="550" y="118" text-anchor="middle" class="diag-sub">listen / poll @ N ms</text>
    <path d="M400 130 L700 130" class="diag-line-dotted" marker-end="url(#sub-arrow)" />

    <text x="550" y="158" text-anchor="middle" class="diag-sub">delta + cursor</text>
    <path d="M700 170 L400 170" class="diag-line" marker-end="url(#sub-arrow)" />

    <text x="250" y="198" text-anchor="middle" class="diag-sub">SSE · WebSocket frame</text>
    <path d="M400 210 L100 210" class="diag-line" marker-end="url(#sub-arrow)" />

    <text x="250" y="238" text-anchor="middle" class="diag-sub">repeat · resume by cursor</text>
    <path d="M400 250 L100 250" class="diag-line-dotted" marker-end="url(#sub-arrow)" />
  </svg>
</div>