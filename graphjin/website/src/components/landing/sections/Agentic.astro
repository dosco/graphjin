---
import Section from "../Section.astro";

const loop = [
  {
    label: "Discover",
    title: "gj_catalog",
    body: "Find schemas, relationships, syntax, workflows, capabilities, examples, and evidence before choosing a path.",
  },
  {
    label: "Check",
    title: "gj_security",
    body: "Read effective policy and high-risk findings before config, workflow, file, code, or mutation actions.",
  },
  {
    label: "Validate",
    title: "preview",
    body: "Validate filters, inspect generated work, run approved workflows, or preview CodeSQL changes before applying.",
  },
  {
    label: "Act",
    title: "governed surface",
    body: "Execute through GraphQL, MCP, saved queries, workflows, and guarded source operations instead of raw credentials.",
  },
];

const surfaces = [
  "Application data",
  "Remote APIs",
  "Files and objects",
  "Source code",
  "Workflows",
  "Config",
  "Security posture",
];
---

<Section
  id="agentic"
  eyebrow="AGENTIC GRAPHJIN"
  title="Auto-learn, compile, govern, audit."
  lede="GraphJin is the operating graph agents use to understand a real organization. It auto-learns the live surface, compiles GraphQL into database and source-backed work, and keeps policy visible enough for both humans and models to inspect."
>
  <div class="agentic-grid">
    <div class="agentic-loop" aria-label="Agentic GraphJin operating loop">
      <div class="agentic-loop-line">
        gj_catalog -> evidence -> gj_security -> validate/preview -> governed action -> observe/refresh
      </div>

      <div class="agentic-steps">
        {loop.map((item, index) => (
          <article class="agentic-step">
            <span>{String(index + 1).padStart(2, "0")} · {item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>

    <aside class="agentic-panel">
      <span class="agentic-panel-kicker">One operating graph</span>
      <h3>Not a pile of wrappers. Not a prompt full of guesses.</h3>
      <p>
        The agent learns from graph evidence: catalog rows, security rows,
        relationships, code references, workflow metadata, config facts,
        validation results, preview diffs, and execution results.
      </p>
      <div class="agentic-surfaces">
        {surfaces.map((surface) => (
          <span>{surface}</span>
        ))}
      </div>
    </aside>
  </div>
</Section>

<style>
  .agentic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);
    gap: 1rem;
    align-items: stretch;
  }

  .agentic-loop,
  .agentic-panel {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .agentic-loop {
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .agentic-loop-line {
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-accent-soft) 45%, var(--color-bg));
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  :root[data-theme="dark"] .agentic-loop-line {
    background: rgba(182, 252, 52, 0.08);
    color: var(--color-accent-readable);
  }

  .agentic-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .agentic-step {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    padding: 1rem;
  }

  .agentic-step span,
  .agentic-panel-kicker {
    display: block;
    color: var(--color-accent-readable);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .agentic-step h3,
  .agentic-panel h3 {
    margin-top: 0.45rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .agentic-step h3 {
    font-size: 1.05rem;
  }

  .agentic-step p,
  .agentic-panel p {
    margin-top: 0.45rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .agentic-step p {
    font-size: 0.92rem;
  }

  .agentic-panel {
    padding: clamp(1.15rem, 2vw, 1.5rem);
  }

  .agentic-panel h3 {
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.08;
  }

  .agentic-surfaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  .agentic-surfaces span {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.38rem 0.62rem;
    background: var(--color-bg);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 900px) {
    .agentic-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .agentic-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
