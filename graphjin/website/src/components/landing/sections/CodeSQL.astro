---
import Section from "../Section.astro";

const facts = [
  { label: "symbol", value: "createInvoiceHandler", meta: "api/invoices.ts" },
  { label: "column ref", value: "users.email", meta: "api/users.go" },
  { label: "refresh", value: "dev live watch", meta: "prod restart sync" },
];

const tables = ["gj_columns", "code_db_refs", "code_symbols", "code_docs", "code_files"];
---

<Section
  id="codesql"
  eyebrow="CODE INTELLIGENCE"
  title="CodeSQL: query your code as well"
  lede="GraphJin turns databases, HTTP APIs, discovered metadata, source code, and filesystems into one governed graph for AI agents. CodeSQL lets agents ask where a column exists, which code references it, which symbol owns that reference, and what guarded change set would update it — with preview/apply checks instead of raw file writes."
>
  <div class="codesql-showcase" aria-label="CodeSQL turns source code into queryable tables">
    <div class="codesql-topline">
      <div class="codesql-ask">
        <span>agent asks</span>
        <strong>Where is users.email used?</strong>
        <code>gj_columns &#123; code_db_refs &#123; file &#123; path &#125; symbol &#123; name &#125; &#125; &#125;</code>
      </div>

      <aside class="codesql-config-card" aria-label="CodeSQL configuration example">
        <header>config/prod.yml</header>
        <pre><code><span>app_code:</span>
  <em>type:</em> codesql
  <em>path:</em> /srv/app</code></pre>
      </aside>
    </div>

    <div class="codesql-map">
      <div class="codesql-thread codesql-thread-a" aria-hidden="true"></div>
      <div class="codesql-thread codesql-thread-b" aria-hidden="true"></div>

      <article class="codesql-source-card">
        <header>
          <span>api/invoices.ts</span>
          <em>source</em>
        </header>
        <pre><code><span class="tok-key">export async function</span> <span class="tok-fn">createInvoiceHandler</span><span class="tok-punc">(</span><span class="tok-var">req</span><span class="tok-punc">)</span> <span class="tok-punc">&#123;</span>
  <span class="tok-key">return</span> <span class="tok-var">workflows</span><span class="tok-punc">.</span><span class="tok-fn">run</span><span class="tok-punc">(</span><span class="tok-str">"sync-invoices"</span><span class="tok-punc">)</span>
<span class="tok-punc">&#125;</span></code></pre>
      </article>

      <div class="codesql-lens">
        <span>CodeSQL</span>
        <strong>tree-sitter + metadata</strong>
        <em>read-only SQLite graph</em>
      </div>

      <div class="codesql-table-cloud" aria-label="Queryable CodeSQL tables">
        {tables.map((table) => (
          <span>{table}</span>
        ))}
      </div>

      <section class="codesql-results" aria-label="CodeSQL query results">
        <header>matched rows</header>
        {facts.map((fact) => (
          <div>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
            <em>{fact.meta}</em>
          </div>
        ))}
      </section>
    </div>
  </div>
</Section>
