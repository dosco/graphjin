---
import Section from "../Section.astro";
import CodeCard from "../CodeCard.astro";

const config = `# config/prod.yml
federation:
  enabled: true
  version: v2.5
  keys:
    users: "id"
    products: "sku"`;
---

<Section
  id="federation"
  eyebrow="ADVANCED · SUPERGRAPH"
  title="Drop GraphJin into a federated supergraph."
  lede="Already running Apollo Router, Cosmo, or Hive? Flip one config flag and every primary-keyed table becomes a federation v2 subgraph — SDL with @key, @shareable, and @inaccessible directives, plus a working _service entry point. No resolver code."
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
    <div>
      <CodeCard filename="config/prod.yml" language="yaml" code={config} />
    </div>
    <ul class="text-sm leading-relaxed space-y-2" style="color: var(--color-muted)">
      <li>· Generated SDL refreshes on schema change</li>
      <li>· Per-table key overrides; field-level <code class="font-mono" style="color: var(--color-text)">@shareable</code> / <code class="font-mono" style="color: var(--color-text)">@inaccessible</code></li>
      <li>· Multiple GraphJin processes compose into one supergraph</li>
      <li>· Same RBAC + allow-lists apply to entity references</li>
    </ul>
  </div>
</Section>
