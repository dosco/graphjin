{
  "name": "graphjin-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:install-script": "node ./scripts/sync-install-script.mjs",
    "dev": "npm run sync:install-script && HUGO_CACHEDIR=$PWD/resources/_gen hugo server --bind 127.0.0.1 --port 1313 --disableFastRender",
    "hugo": "HUGO_CACHEDIR=$PWD/resources/_gen hugo --gc --minify --printPathWarnings",
    "og": "node ./scripts/generate-benchmark-og.mjs",
    "index": "pagefind --site public --output-path public/pagefind --include-characters '@/._-+#'",
    "build": "npm run sync:install-script && npm run hugo && npm run og && npm run index",
    "check": "node ./scripts/check-site.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "pagefind": "^1.5.2"
  }
}
